#!/usr/bin/env bash
# gkey - run OpenAI-compatible CLI tools on your Antigravity login. See README.md.
set -euo pipefail

# Resolve the package directory (follows symlinks, e.g. npm's bin link).
SELF="${BASH_SOURCE[0]}"
while [[ -L "${SELF}" ]]; do
  LINK_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
  SELF="$(readlink "${SELF}")"
  [[ "${SELF}" != /* ]] && SELF="${LINK_DIR}/${SELF}"
done
GKEY_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
export GKEY_SELF="${GKEY_DIR}/$(basename "${SELF}")"

GKEY_HOME="${GKEY_HOME:-$HOME/.gkey}"
export GKEY_HOME
mkdir -p "${GKEY_HOME}/run" "${GKEY_HOME}/logs"

if [[ -n "${GKEY_PYTHON:-}" ]]; then
  PYTHON_BIN="${GKEY_PYTHON}"
elif [[ -x "${GKEY_HOME}/venv/bin/python" ]]; then
  PYTHON_BIN="${GKEY_HOME}/venv/bin/python"
else
  PYTHON_BIN="$(command -v python3 || true)"
fi
if [[ -z "${PYTHON_BIN}" ]]; then
  echo "[gkey] Error: python3 not found. Install Python 3.9+ or run gkey via 'npx gkey-cli'." >&2
  exit 1
fi
SERVER_SCRIPT="${GKEY_DIR}/server.py"
CATALOG_SCRIPT="${GKEY_DIR}/catalog.py"
MENU_SCRIPT="${GKEY_DIR}/menu.py"

PORT="${GKEY_PORT:-18432}"
HOST="${GKEY_HOST:-127.0.0.1}"
MODEL="${GKEY_MODEL:-gemini-3.8-flash-low}"
BACKEND="${GKEY_BACKEND:-auto}"
EFFORT="${GKEY_EFFORT:-low}"
DEFAULT_POOL="${GKEY_POOL_SIZE:-4}"
EXPLICIT_POOL=""
POOL_SIZE="${DEFAULT_POOL}"

# Make the venv's tools (e.g. uv) and common user bin dirs visible.
export PATH="${GKEY_HOME}/venv/bin:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/go/bin:$HOME/.cargo/bin:/opt/homebrew/bin:$PATH"

set_paths() {
  PID_FILE="${GKEY_HOME}/run/proxy-${PORT}.pid"
  LOG_FILE="${GKEY_HOME}/logs/proxy-${PORT}.log"
}
set_paths

usage() {
  cat <<EOF
gkey - run OpenAI-compatible CLI tools on your Antigravity login (no API key needed)

Usage:
  gkey                                  Open the tool menu (fzf if installed, built-in otherwise)
  gkey [options] <tool> [args...]       Run a tool; installs it and fills in the OpenAI flags for you
  gkey info <tool>                      Show details, examples and what gkey adapts for a tool

Examples:
  gkey pdf2zh paper.pdf                 Translate a paper to Traditional Chinese (keeps math and layout);
                                        also writes <name>-zh-TW-then-en.pdf (Chinese pages, then originals)
  gkey pdf2zh paper.pdf --layout dual   pdf2zh's own outputs only (no merged PDF); -lo ja for another language
  gkey pdf2zh paper.pdf -t 8            8 threads; gkey grows its worker pool to match
  gkey markitdown input.pdf -o out.md   Any document to Markdown
  gkey gpt-subtrans movie.srt -o zh.srt Translate subtitles
  git diff | gkey mods "review this"    LLM in a UNIX pipe
  gkey oco                              Commit message from your staged diff

Options (before <tool>):
  -m, --model <model>       Antigravity model (default: ${MODEL})
                            e.g. gemini-3.8-flash-low, gemini-4-argon-medium,
                                 claude-sonnet-5-5-medium, claude-opus-5-5-medium
  -b, --backend <mode>      auto | sdk | agy (default: ${BACKEND})
  -e, --effort <level>      low | medium | high (default: ${EFFORT})
  -p, --port <port>         Local proxy port (default: ${PORT})
      --pool-size <n>       Proxy worker pool size, 1-16 (default: ${DEFAULT_POOL}; auto-grows
                            when the tool's own thread flag, e.g. pdf2zh -t 8, asks for more)

Benchmark (no real model calls unless --bench-real):
  --bench                   Measure proxy overhead against a fake backend (p50/p95/max, req/s)
      --concurrency <n>     Parallel clients (default: 4)
      --requests <m>        Total requests (default: 40)
  --bench-real              Send ONE tiny prompt per backend (agy, sdk) and print time-to-first-token

Management:
  --list                    List the supported tools and install status
  --install <tool>          Install a tool without running it
  --status | --start | --stop | --restart
  --logs                    Follow the proxy log (${LOG_FILE})
  --env                     Print export lines for the proxy environment
  -h, --help                This help

Data dir: ${GKEY_HOME} (override with GKEY_HOME). Docs: README.md
EOF
}

health_json() {
  curl -fsS --max-time 1 "http://${HOST}:${PORT}/health" 2>/dev/null || true
}

is_running() {
  [[ -n "$(health_json)" ]]
}

# Extract a field from the compact /health JSON: health_field '<json>' key
health_field() {
  printf '%s' "$1" | sed -n "s/.*\"$2\":\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p"
}

stop_daemon() {
  if [[ -f "${PID_FILE}" ]]; then
    local pid
    pid=$(cat "${PID_FILE}" 2>/dev/null || true)
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
      for _ in {1..30}; do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 0.1
      done
    fi
    rm -f "${PID_FILE}"
  fi
  # Only fall back to the port owner when it is one of our own servers.
  if command -v lsof >/dev/null 2>&1; then
    local port_pids pid cmd
    port_pids=$(lsof -ti tcp:"${PORT}" -sTCP:LISTEN 2>/dev/null || true)
    for pid in ${port_pids}; do
      cmd=$(ps -o command= -p "${pid}" 2>/dev/null || true)
      if [[ "${cmd}" == *"server.py"* ]]; then
        kill "${pid}" 2>/dev/null || true
      fi
    done
  fi
}

# Decide whether the running daemon must be restarted to honour this invocation.
# Explicit -m/-b/-e flags and --pool-size must match; an auto-sized pool only ever grows.
daemon_needs_restart() {
  local h running_pool
  h="$(health_json)"
  [[ -z "${h}" ]] && return 1
  [[ -n "${OPT_MODEL}" && "$(health_field "${h}" default_model)" != "${MODEL}" ]] && return 0
  [[ -n "${OPT_BACKEND}" && "$(health_field "${h}" backend_mode)" != "${BACKEND}" ]] && return 0
  [[ -n "${OPT_EFFORT}" && "$(health_field "${h}" effort)" != "${EFFORT}" ]] && return 0
  running_pool="$(health_field "${h}" pool_size)"
  running_pool="${running_pool:-0}"
  if [[ -n "${EXPLICIT_POOL}" ]]; then
    [[ "${running_pool}" != "${POOL_SIZE}" ]] && return 0
  else
    [[ "${running_pool}" -lt "${POOL_SIZE}" ]] && return 0
  fi
  return 1
}

start_daemon() {
  if is_running; then
    return 0
  fi

  nohup "${PYTHON_BIN}" "${SERVER_SCRIPT}" \
    --host "${HOST}" \
    --port "${PORT}" \
    --backend "${BACKEND}" \
    --model "${MODEL}" \
    --effort "${EFFORT}" \
    --pool-size "${POOL_SIZE}" \
    >"${LOG_FILE}" 2>&1 &

  local pid=$!
  echo "${pid}" >"${PID_FILE}"

  local ready=0
  for _ in {1..100}; do
    if is_running; then
      ready=1
      break
    fi
    if ! kill -0 "${pid}" 2>/dev/null; then
      echo "[gkey] Error: proxy exited unexpectedly. Log (${LOG_FILE}):" >&2
      tail -n 40 "${LOG_FILE}" >&2
      exit 1
    fi
    sleep 0.1
  done

  if [[ "${ready}" -ne 1 ]]; then
    echo "[gkey] Error: timed out waiting for the proxy on http://${HOST}:${PORT}" >&2
    exit 1
  fi

  # With the agy backend, wait (bounded) until at least one worker is warm.
  local h err
  for _ in {1..150}; do
    h="$(health_json)"
    [[ "$(health_field "${h}" active_engine)" == "sdk" ]] && break
    [[ "$(health_field "${h}" warm_workers)" != "0" ]] && break
    err="$(health_field "${h}" last_warm_error)"
    if [[ -n "${err}" && "${err}" != "null" ]]; then
      echo "[gkey] Warning: agy worker failed to start: ${err}" >&2
      break
    fi
    sleep 0.2
  done
}

ensure_daemon() {
  if daemon_needs_restart; then
    echo "[gkey] Restarting proxy to apply new settings (model=${MODEL}, backend=${BACKEND}, effort=${EFFORT}, pool=${POOL_SIZE})" >&2
    stop_daemon
  fi
  start_daemon
}

compute_pool() {
  # compute_pool [tool args...]: sets POOL_SIZE from the default, --pool-size and the tool's own thread flag.
  POOL_SIZE="$("${PYTHON_BIN}" "${CATALOG_SCRIPT}" poolsize "${DEFAULT_POOL}" "${EXPLICIT_POOL:--}" "$@" 2>/dev/null || echo "${DEFAULT_POOL}")"
}

ACTION=""
INSTALL_TARGET=""
OPT_MODEL=""; OPT_BACKEND=""; OPT_EFFORT=""
BENCH_CONC=4; BENCH_REQS=40

need_value() {
  if [[ $# -lt 2 || -z "${2:-}" ]]; then
    echo "[gkey] Error: $1 needs a value" >&2
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model) need_value "$@"; MODEL="$2"; OPT_MODEL=1; shift 2 ;;
    -b|--backend) need_value "$@"; BACKEND="$2"; OPT_BACKEND=1; shift 2 ;;
    -e|--effort) need_value "$@"; EFFORT="$2"; OPT_EFFORT=1; shift 2 ;;
    -p|--port) need_value "$@"; PORT="$2"; set_paths; shift 2 ;;
    --pool-size) need_value "$@"; EXPLICIT_POOL="$2"; shift 2 ;;
    --concurrency) need_value "$@"; BENCH_CONC="$2"; shift 2 ;;
    --requests) need_value "$@"; BENCH_REQS="$2"; shift 2 ;;
    --bench) ACTION="bench"; shift ;;
    --bench-real) ACTION="bench-real"; shift ;;
    --list) ACTION="list"; shift ;;
    --install) need_value "$@"; ACTION="install"; INSTALL_TARGET="$2"; shift 2 ;;
    --status) ACTION="status"; shift ;;
    --start) ACTION="start"; shift ;;
    --stop) ACTION="stop"; shift ;;
    --restart) ACTION="restart"; shift ;;
    --logs) ACTION="logs"; shift ;;
    --env) ACTION="env"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "[gkey] Unknown option: $1" >&2; usage >&2; exit 1 ;;
    *) break ;;
  esac
done

if ! [[ "${PORT}" =~ ^[0-9]+$ ]]; then echo "[gkey] Error: invalid port '${PORT}'" >&2; exit 1; fi
if [[ -n "${EXPLICIT_POOL}" ]] && ! [[ "${EXPLICIT_POOL}" =~ ^[0-9]+$ ]]; then
  echo "[gkey] Error: --pool-size must be a positive integer" >&2; exit 1
fi
if ! [[ "${DEFAULT_POOL}" =~ ^[0-9]+$ ]]; then DEFAULT_POOL=4; fi

# `gkey info <tool>` / `gkey help [tool]`
if [[ -z "${ACTION}" && $# -gt 0 ]]; then
  case "$1" in
    info|help)
      if [[ $# -ge 2 ]]; then
        "${PYTHON_BIN}" "${CATALOG_SCRIPT}" info "$2"
      else
        usage
      fi
      exit 0 ;;
  esac
fi

compute_pool "$@"
case "${ACTION}" in
  bench|bench-real)
    for v in "${BENCH_CONC}" "${BENCH_REQS}"; do
      [[ "${v}" =~ ^[1-9][0-9]*$ ]] || { echo "[gkey] Error: --concurrency/--requests must be positive integers" >&2; exit 1; }
    done
    exec "${PYTHON_BIN}" "${GKEY_DIR}/bench.py" "--${ACTION#bench-}" \
      --concurrency "${BENCH_CONC}" --requests "${BENCH_REQS}" \
      --pool-size "${EXPLICIT_POOL:-${DEFAULT_POOL}}" --model "${MODEL}" --effort "${EFFORT}" ;;
  list)
    "${PYTHON_BIN}" "${CATALOG_SCRIPT}" list
    exit 0 ;;
  install)
    "${PYTHON_BIN}" "${CATALOG_SCRIPT}" install "${INSTALL_TARGET}"
    exit 0 ;;
  status)
    if is_running; then
      echo "[gkey] Proxy is RUNNING at http://${HOST}:${PORT}/v1"
      health_json; echo ""
    else
      echo "[gkey] Proxy is STOPPED (port ${PORT})"
    fi
    exit 0 ;;
  start)
    ensure_daemon
    echo "[gkey] Proxy ready at http://${HOST}:${PORT}/v1"
    health_json; echo ""
    exit 0 ;;
  stop)
    stop_daemon
    echo "[gkey] Proxy stopped."
    exit 0 ;;
  restart)
    stop_daemon
    start_daemon
    echo "[gkey] Proxy restarted at http://${HOST}:${PORT}/v1"
    health_json; echo ""
    exit 0 ;;
  logs)
    if [[ ! -f "${LOG_FILE}" ]]; then echo "[gkey] No log yet (${LOG_FILE})" >&2; exit 1; fi
    tail -n 100 -f "${LOG_FILE}"
    exit 0 ;;
  env)
    cat <<EOF
export OPENAI_BASE_URL="http://${HOST}:${PORT}/v1"
export OPENAI_API_BASE="http://${HOST}:${PORT}/v1"
export OPENAI_API_BASE_URL="http://${HOST}:${PORT}/v1"
export OPENAI_PROXY_URL="http://${HOST}:${PORT}/v1"
export OPENAI_API_KEY="gkey-local-placeholder"   # public placeholder, not a secret
export OPENAI_MODEL="${MODEL}"
EOF
    exit 0 ;;
esac

# No command: open the tool menu.
if [[ $# -eq 0 ]]; then
  exec "${PYTHON_BIN}" "${MENU_SCRIPT}"
fi

ensure_daemon

exec "${PYTHON_BIN}" "${CATALOG_SCRIPT}" adapt "${PORT}" "${MODEL}" "$@"
